{
  "name": "boxpressd-app-store",
  "version": "0.8.00",
  "private": true,
  "dependencies": {
    "mobile-device-detect": "^0.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "react-slick": "^0.29.0",
    "slick-carousel": "^1.8.1",
    "web-vitals": "^2.1.4",
    "wow.js": "^1.2.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy:prod": "npm run build && aws s3 sync build/ s3://appstore.boxpressd.com --acl public-read",
    "deploy:pre": "npm run build && aws s3 sync build/ s3://staging-appstore.boxpressd.com --acl public-read",
    "deploy": "npm run build && aws s3 sync build/ s3://dev-appstore.boxpressd.com --acl public-read"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
